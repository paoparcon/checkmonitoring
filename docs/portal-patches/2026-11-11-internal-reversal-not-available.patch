+-- An INTERNAL check (payroll, tax, inter-company, petty cash) that Check
+-- Monitoring un-releases is NOT available for release here (spec
+-- 2026-11-11-cm-internal-reversal-not-available). Check Monitoring sends no
+-- MARK_AVAILABLE for an internal check, so no payee is ever told to collect
+-- one; until 2026-11-11 an internal RELEASE_REVERSED still put the row at
+-- AVAILABLE_FOR_RELEASE (spec 2026-10-19), and the Checks Available tile counted
+-- it: three internal checks un-released on 2026-11-09 (AP-ST045586, AP-HF002250,
+-- AP-ST045588) read 109 here against 106 in Check Monitoring. The code now lands
+-- such an undo on READY_FOR_SIGNATURE; this moves the rows that are already
+-- wrong, audited one row each. An internal row a portal user announced
+-- (notified_at set) is theirs and is left alone, as is every supplier row.
+insert into audit_log (action, entity, entity_id, before, after, remarks)
+select 'check_monitoring_internal_reversal_fix', 'check_release', id::text,
+       '{"status":"AVAILABLE_FOR_RELEASE"}'::jsonb, '{"status":"READY_FOR_SIGNATURE"}'::jsonb,
+       'migration 097: an internal check un-released by Check Monitoring is not available for release (spec 2026-11-11)'
+  from check_release
+ where internal_payee = true and status = 'AVAILABLE_FOR_RELEASE' and notified_at is null;
+update check_release
+   set status = 'READY_FOR_SIGNATURE', release_date = null,
+       pickup_date = null, pickup_time = '', pickup_rep = '', confirmed_at = null, confirmed_by = null,
+       reminded_on = null, remind_count = 0, updated_at = now()
+ where internal_payee = true and status = 'AVAILABLE_FOR_RELEASE' and notified_at is null;
